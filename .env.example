# ══════════════════════════════════════════════════════
# TRISASTRA AI — Docker Compose Environment Variables
# Copy this file to .env and fill in your API keys
# ══════════════════════════════════════════════════════

# ── LLM API Keys ──
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ── Sarvam AI (Telugu & Tamil CAM reports) ──
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_MODEL=sarvam-105b-conversations

# ── Security ──
JWT_SECRET_KEY=change-me-to-random-64-char-hex
AGENT_SERVICE_TOKEN=change-me-to-random-48-char-hex

# ── Auth (leave blank to disable OIDC) ──
OIDC_ISSUER=
OIDC_AUDIENCE=

# ── SurePass KYC (optional) ──
SUREPASS_API_KEY=
